# Shared across apps/family and apps/admin (copy to .env.local in each app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/family only — public VAPID key for Web Push subscriptions. Generate a
# pair with `npx web-push generate-vapid-keys`; the private key is an Edge
# Function secret (push-dispatch), never put it here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only / used by packages/gps-sim local ticker, edge functions, and
# (in apps/admin only, as SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) the
# src/app/api/invite-user Route Handler. NEVER expose this to the browser or
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# apps/admin only — server-only. Where invited drivers/parents land to set
# their password (apps/family's /set-password page).
FAMILY_APP_URL=
