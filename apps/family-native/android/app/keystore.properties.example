# Copy this file to keystore.properties (same directory) and fill in real
# values after generating your own release keystore -- see
# ../../PLAY_STORE_SUBMISSION.md for the exact keytool command. This file
# (keystore.properties.example) is safe to commit; keystore.properties
# itself is gitignored and must never be committed -- it's the permanent,
# unrotatable signing identity of the app on the Play Store.

# Absolute path to the .jks/.keystore file. Keep the real file itself
# outside the repo, or anywhere already gitignored -- never inside a
# location that could accidentally get committed.
storeFile=/absolute/path/to/sabidrive-release.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=sabidrive
keyPassword=REPLACE_WITH_KEY_PASSWORD
